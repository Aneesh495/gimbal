q16_t lookup_sin_fast(q16_t angle_rad) {
    q16_t two_pi = 411775;
    while (angle_rad < 0) angle_rad += two_pi;
    while (angle_rad >= two_pi) angle_rad -= two_pi;
    uint32_t idx = (uint32_t)(((int64_t)angle_rad * SINE_TABLE_SIZE) / two_pi);
    if (idx >= SINE_TABLE_SIZE) idx = SINE_TABLE_SIZE - 1;
    return g_sine_table_q16[idx];
}

q16_t lookup_cos_fast(q16_t angle_rad) {
    q16_t two_pi = 411775;
    while (angle_rad < 0) angle_rad += two_pi;
    while (angle_rad >= two_pi) angle_rad -= two_pi;
    uint32_t idx = (uint32_t)(((int64_t)angle_rad * SINE_TABLE_SIZE) / two_pi);
    if (idx >= SINE_TABLE_SIZE) idx = SINE_TABLE_SIZE - 1;
    return g_cosine_table_q16[idx];
}
