const q16_t* get_motor_cogging_table(uint8_t motor_id) {
    switch (motor_id) {
        case 0: return g_cogging_profile_tmotor_gb54;
        case 1: return g_cogging_profile_maxon_ec45;
        case 2: return g_cogging_profile_basecam_5208;
        case 3: return g_cogging_profile_kde_direct_5215;
        case 4: return g_cogging_profile_moons_bldc_42;
        case 5: return g_cogging_profile_faulhaber_3268;
        case 6: return g_cogging_profile_allied_motion_45;
        case 7: return g_cogging_profile_custom_direct_drive;
        default: return g_cogging_profile_tmotor_gb54;
    }
}
