q16_t evaluate_spline_position(uint16_t spline_id, q16_t t_norm) {
    if (spline_id >= TRAJECTORY_SPLINE_COUNT) spline_id = 0;
    const quintic_spline_segment_t *s = &g_quintic_trajectory_splines[spline_id];
    q16_t t2 = q16_mul(t_norm, t_norm);
    q16_t t3 = q16_mul(t2, t_norm);
    q16_t t4 = q16_mul(t3, t_norm);
    q16_t t5 = q16_mul(t4, t_norm);
    return q16_mul(s->c3, t3) + q16_mul(s->c4, t4) + q16_mul(s->c5, t5);
}
