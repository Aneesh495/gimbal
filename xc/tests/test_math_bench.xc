bool run_math_bench(void) {
    bool all_passed = true;
    for (int i = 0; i < MATH_TEST_VECTORS; i++) {
        q16_t s_calc, c_calc;
        q16_cordic_sin_cos(g_math_test_vectors[i].input_angle_rad, &s_calc, &c_calc);
        q16_t err_s = q16_abs(s_calc - g_math_test_vectors[i].expected_sin);
        q16_t err_c = q16_abs(c_calc - g_math_test_vectors[i].expected_cos);
        /* CORDIC 16 iterations tolerance: +/- 64 in Q16 (~0.001) */
        if (err_s > 128 || err_c > 128) {
            all_passed = false;
        }
    }
    return all_passed;
}
